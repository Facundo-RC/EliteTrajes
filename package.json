{
  "name": "elite-trajes",
  "version": "1.0.0",
  "description": "Sitio de alquiler de trajes y accesorios: catálogo con filtros y simulador de reservas.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sass --no-source-map --style=compressed sass/style.scss css/main.css",
    "watch": "sass --watch --no-source-map sass/style.scss css/main.css",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "bootstrap": "^5.3.3",
    "http-server": "^14.1.1",
    "sass": "^1.80.0"
  }
}
